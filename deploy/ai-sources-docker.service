[Unit]
Description=Personal AI Representative Docker stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/root/AI-Sources-Project
ExecStart=/usr/bin/docker compose -f deploy/docker-compose.app.yml up -d --build
ExecStop=/usr/bin/docker compose -f deploy/docker-compose.app.yml down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
